{
  "manifest_version": 3,
  "name": "Astronáutica",
  "short_name": "Astronáutica",
  "version": "0.7.2",
  "description": "Acampamento Meio-Sangue, Hotel Valhala e Casa do Brooklyn: foco com pausa, ciclo de estudos, humor, contadores, captura, hábitos, missões, gastos e aviso de cada faixa do dia. Abre como popup, painel lateral ou janela solta.",
  "icons": {
    "16": "icones/icone-16.png",
    "32": "icones/icone-32.png",
    "48": "icones/icone-48.png",
    "128": "icones/icone-128.png"
  },
  "action": {
    "default_title": "Astronáutica",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icones/icone-16.png",
      "32": "icones/icone-32.png"
    }
  },
  "side_panel": {
    "default_path": "lateral.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "sidePanel",
    "offscreen"
  ],
  "host_permissions": [
    "https://gubpygurtxadsncthttg.supabase.co/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Abrir a Astronáutica"
    }
  }
}
